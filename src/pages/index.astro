---
import Layout from '../layouts/Layout.astro';
import { products } from "../data";
import ProductCard from "../components/ProductCard.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";

const title = "GEPETTO CARPINTERIA.";
const intro = 'Cajas en madera para detalles y desayunos sorpresa.';
---

<Layout title={title}>
  <div>
    <h1 class="text-5xl pb-3 font-bold mb-4">{title}</h1>
    <h3 class="text-2xl text-gray-500 mb-8">{intro}</h3>

    <!-- Productos -->
    <div class="flex flex-wrap gap-4 py-8">
      {products.map((product) => (
        <ProductCard product={product} /> <!-- Se pasa correctamente el objeto product -->
      ))}
    </div>
  </div>


  <!-- Agregar el ícono de WhatsApp en la parte inferior derecha -->
  <WhatsAppIcon />
</Layout>


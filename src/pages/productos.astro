---
// src/pages/Productos.astro
import Layout from '../layouts/Layout.astro';
import { products, type Product } from "../data"; // Importa el tipo Product

const title = "Nuestros Productos";
---

<Layout title={title}>
  <div class="p-4"> <!-- Se añadió padding alrededor del contenedor -->
    <h1 class="text-4xl font-bold mb-8">{title}</h1>
    
    <!-- Contenedor de productos con clases responsivas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product: Product) => (
        <div class="border p-4 rounded-lg shadow-lg">
          <!-- Imagen con altura automática para mayor flexibilidad en pantallas pequeñas -->
          <img src={product.cover} alt={product.name} class="w-full h-auto object-cover mb-4" />
          
          <!-- Nombre del producto -->
          <h2 class="text-2xl font-semibold mb-2">{product.name}</h2>
          
          <!-- Descripción del producto -->
          <p class="text-gray-700 mb-4">{product.description}</p>
          
          <!-- Botón responsivo -->
          <button class="bg-blue-500 text-white px-4 py-2 rounded w-full sm:w-auto">
            Ver más
          </button>
        </div>
      ))}
    </div>
  </div>
</Layout>

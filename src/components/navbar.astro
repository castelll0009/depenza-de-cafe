---
import { ViewTransitions } from 'astro:transitions';
---

<nav class="bg-gray-800 text-white p-4">
  <div class="container mx-auto flex justify-between items-center">
    <!-- Logotipo -->
    <div class="text-xl font-bold">
      <a href="/">CAJITAS GEPETTO POPAYAN</a>
    </div>
    
    <!-- Botón de menú para pantallas móviles -->
    <div class="lg:hidden">
      <input type="checkbox" id="menu-toggle" class="hidden" />
      <label for="menu-toggle" class="flex items-center cursor-pointer">
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
      
      <!-- Menú desplegable en pantallas móviles -->
      <div class="absolute right-0 mt-2 w-48 bg-gray-800 text-white hidden" id="menu-content">
        <ul class="flex flex-col space-y-2">
          <li><a href="/" class="block py-2 px-4 hover:bg-gray-700">Inicio</a></li>
          <li><a href="/productos" class="block py-2 px-4 hover:bg-gray-700">Productos</a></li>
          <li><a href="/contacto" class="block py-2 px-4 hover:bg-gray-700">Contacto</a></li>
          <li><a href="/sobre-nosotros" class="block py-2 px-4 hover:bg-gray-700">Sobre Nosotros</a></li>
        </ul>
      </div>
    </div>
    
    <!-- Menú de navegación en pantallas grandes -->
    <ul class="hidden lg:flex space-x-4">
      <li><a href="/" class="hover:underline">Inicio</a></li>
      <li><a href="/productos" class="hover:underline">Productos</a></li>
      <li><a href="/contacto" class="hover:underline">Contacto</a></li>
      <li><a href="/sobre-nosotros" class="hover:underline">Sobre Nosotros</a></li>
    </ul>
  </div>

  <style is:global>
    /* Mostrar el menú desplegable en móviles cuando el checkbox está marcado */
    #menu-toggle:checked + label + #menu-content {
      display: block;
    }
  </style>
</nav>
